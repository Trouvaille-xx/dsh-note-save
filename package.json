{
  "name": "dsh-note-save",
  "version": "0.1.0",
  "description": "Save a conversation, a turn or a single message as a note in Obsidian, SiYuan, Joplin, Notion, Yuque or ima.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": { "node": ">=20", "dsh": ">=0.1.2-rc.1 <0.3.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trouvaille-xx/dsh-note-save.git"
  },
  "homepage": "https://github.com/Trouvaille-xx/dsh-note-save#readme",
  "bugs": { "url": "https://github.com/Trouvaille-xx/dsh-note-save/issues" },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "siyuan",
    "joplin",
    "notion",
    "yuque",
    "ima",
    "notes"
  ],
  "license": "MIT"
}
